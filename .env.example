# Persistent storage directory (mount to SSD / HDD volume on Proxmox)
CORTEX_DATA_DIR=./data

# Bootstrap administrator credentials (change before exposing over LAN/VPN)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cortex-admin-change-me

# Application encryption key for server-side provider secret encryption (min 32 chars recommended)
APP_SECRET=change-this-secret-to-a-random-32-plus-character-string

# Optional provider configurations (can also be configured in Settings UI)
GEMINI_API_KEY=
COPILOT_GITHUB_TOKEN=
JUNIE_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Optional webhook bearer token for headless quick capture (POST /api/capture)
CORTEX_CAPTURE_TOKEN=

# Optional external OAuth login indicator (reverse proxy / Authentik / Authelia header)
TRUSTED_PROXY_AUTH_HEADER=
